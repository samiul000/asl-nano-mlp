/*
 * Timing-probe firmware — auto-generated by export_scaling_firmware.py
 * Variant: int16_conv  Dims: 42->64->32->5
 * Response: {sign,infer_us,l0_us,l1_us,l2_us,sm_us,confidence,fps,free_ram}
 */

#include <Arduino.h>
#include "model.h"

#define L0_IN  42
#define L1_OUT 64
#define L2_OUT 32

#define PKT_BUF 240
#define PKT_TIMEOUT_MS 500
#define START_CHAR '<'
#define END_CHAR   '>'

int16_t  input[L0_IN];
int16_t  hidden1[L1_OUT];
int16_t  hidden2[L2_OUT];
float    output[L2_OUT];
#define WBUF_N 2688
static int16_t wbuf[WBUF_N];
unsigned long t_l0 = 0, t_l1 = 0, t_l2 = 0, t_sm = 0;
unsigned long lastInferUs = 0;
float    lastConf = 0.0;
char     lastSign = '?';
unsigned long frameCount = 0;
unsigned long fpsStart = 0;
float    fps = 0;
uint16_t freeRam = 0;
uint16_t peakStack = 0;

char     pktBuf[PKT_BUF];
uint8_t  pktIdx = 0;
unsigned long pktStart = 0;
bool     pktReady = false;

// ---- stack painting: fill [heap_top, SP) with sentinel at boot ----
void paint_stack() {
    extern uint16_t __heap_start, *__brkval;
    uint8_t marker;
    uint8_t *p = (__brkval == 0 ? (uint8_t*)&__heap_start : (uint8_t*)__brkval);
    uint8_t *top = (uint8_t*)&marker;
    while (p < top - 32) *p++ = 0xCD;   // leave 32 B guard for this frame
}

// deepest address overwritten since painting -> true peak bytes above heap
uint16_t measure_stack() {
    extern uint16_t __heap_start, *__brkval;
    uint8_t *p = (__brkval == 0 ? (uint8_t*)&__heap_start : (uint8_t*)__brkval);
    while (p < (uint8_t*)RAMEND && *p == 0xCD) p++;
    return (uint16_t)((uint8_t*)RAMEND - p);
}

uint16_t getFreeRam() {
    extern uint16_t __heap_start, *__brkval;
    uint16_t v;
    return (uint16_t)&v - (__brkval == 0 ? (uint16_t)&__heap_start : (uint16_t)__brkval);
}

float pgm_read_float_p(const void* addr) {
    float f;
    memcpy_P(&f, addr, sizeof(float));
    return f;
}
void layer0() {
    memcpy_P(wbuf, W0, sizeof(W0));
    unsigned long t0 = micros();
    for (int j = 0; j < L1_OUT; j++) {
        int32_t acc = 0;
        for (int i = 0; i < L0_IN; i++)
            acc += (int32_t)input[i] * wbuf[j * L0_IN + i];;
        float z = (float)acc * pgm_read_float_p(&W0_scale[j]) + pgm_read_float_p(&bias0[j]);
        hidden1[j] = z > 0 ? (int16_t)min(z, 32767.0f) : 0;
    }
    t_l0 = micros() - t0;
}

void layer1() {
    memcpy_P(wbuf, W1, sizeof(W1));
    unsigned long t1 = micros();
    for (int j = 0; j < L2_OUT; j++) {
        int32_t acc = 0;
        for (int i = 0; i < L1_OUT; i++)
            acc += (int32_t)hidden1[i] * wbuf[j * L1_OUT + i];;
        float z = (float)acc * pgm_read_float_p(&W1_scale[j]) + pgm_read_float_p(&bias1[j]);
        hidden2[j] = z > 0 ? (int16_t)min(z, 32767.0f) : 0;
    }
    t_l1 = micros() - t1;
}

void layer2() {
    memcpy_P(wbuf, W2, sizeof(W2));
    unsigned long t2 = micros();
    for (int j = 0; j < 5; j++) {
        int32_t acc = 0;
        for (int i = 0; i < L2_OUT; i++)
            acc += (int32_t)hidden2[i] * wbuf[j * L2_OUT + i];;
        output[j] = (float)acc * pgm_read_float_p(&W2_scale[j]) + pgm_read_float_p(&bias2[j]);;
    }
    t_l2 = micros() - t2;
}

void softmax() {
    float mx = output[0];
    for (int i = 1; i < L2_OUT; i++) if (output[i] > mx) mx = output[i];
    float sum = 0;
    for (int i = 0; i < L2_OUT; i++) { output[i] = exp(output[i] - mx); sum += output[i]; }
    for (int i = 0; i < L2_OUT; i++) output[i] /= sum;
}

char predict() {
    layer0(); layer1(); layer2();
    lastInferUs = t_l0 + t_l1 + t_l2;
    unsigned long ts = micros();
    softmax();
    t_sm = micros() - ts;
    int best = 0;
    for (int i = 1; i < 5; i++) if (output[i] > output[best]) best = i;
    lastConf = output[best] * 100.0f;
    return 'A' + best;
}

bool parse_packet() {
    char *start = strchr(pktBuf, START_CHAR);
    char *end = strchr(pktBuf, END_CHAR);
    if (!start || !end || end <= start) return false;
    start++;
    if (end - start < 3) return false;
    char *csSep = strrchr(start, ',');
    if (!csSep || csSep == start) return false;
    int csVal = atoi(csSep + 1);
    *csSep = '\0';
    int idx = 0;
    char *tok = start;
    while (tok && idx < L0_IN) {
        char *next = strchr(tok, ',');
        if (next) *next = '\0';
        input[idx++] = atoi(tok);
        tok = next ? next + 1 : NULL;
    }
    if (idx != L0_IN) return false;
    int32_t sum = 0;
    for (int i = 0; i < L0_IN; i++) sum += input[i];
    return (sum % 100) == csVal;
}

void serial_recv() {
    while (Serial.available()) {
        char c = Serial.read();
        if (c == START_CHAR) { pktIdx = 0; pktStart = millis(); }
        if (pktIdx < PKT_BUF - 1) { pktBuf[pktIdx++] = c; pktBuf[pktIdx] = '\0'; }
        if (c == END_CHAR || c == '\n')
            if (strchr(pktBuf, END_CHAR)) pktReady = true;
    }
    if (pktIdx > 0 && millis() - pktStart > PKT_TIMEOUT_MS) { pktIdx = 0; pktBuf[0] = '\0'; }
}

void setup() {
    Serial.begin(115200);
    paint_stack();
    fpsStart = millis();
    Serial.println("{boot}");
}

void loop() {
    serial_recv();
    if (pktReady) {
        pktReady = false;
        if (parse_packet()) {
            lastSign = predict();
            frameCount++;
            peakStack = measure_stack();
            unsigned long now = millis();
            if (now - fpsStart >= 1000) {
                fps = (float)frameCount * 1000.0f / (now - fpsStart);
                frameCount = 0;
                fpsStart = now;
                freeRam = getFreeRam();
            }
            // {sign,infer,l0,l1,l2,sm,conf,fps,ram,stk}
            Serial.print('{');
            Serial.print(lastSign);       Serial.print(',');
            Serial.print(lastInferUs);    Serial.print(',');
            Serial.print(t_l0);           Serial.print(',');
            Serial.print(t_l1);           Serial.print(',');
            Serial.print(t_l2);           Serial.print(',');
            Serial.print(t_sm);           Serial.print(',');
            Serial.print(lastConf, 1);    Serial.print(',');
            Serial.print((int)fps);       Serial.print(',');
            Serial.print(freeRam);        Serial.print(',');
            Serial.print(peakStack);
            Serial.println('}');
        }
        pktIdx = 0;
        pktBuf[0] = '\0';
    }
}
